# Copy this file to .env and fill in real values for local development.
# Never commit the real .env file (it is gitignored).

# --- Payload CMS ---------------------------------------------------------
# Any long random string used to sign Payload's auth JWTs.
# Generate with: openssl rand -base64 32
PAYLOAD_SECRET=local-dev-only-not-a-real-secret-0123456789

# --- Database (Supabase Postgres) ----------------------------------------
# Get this from your Supabase project: Project Settings > Database >
# Connection string (URI format, "Session pooler" or "Transaction pooler"
# recommended for serverless deployments).

DATABASE_URI=postgresql://postgres:abtW9M%21yCVQ5W%23%2B@db.mcchhauzshwdajkgqjrg.supabase.co:5432/postgres


# --- Supabase Storage (product images, via @payloadcms/storage-s3) -------
# Get these from your Supabase project: Project Settings > Storage >
# S3 Connection. All four must be set together, or the app falls back to
# Payload's default local-disk upload storage (fine for local dev only).
SUPABASE_S3_ENDPOINT=https://your-project-ref.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=us-east-1
SUPABASE_S3_ACCESS_KEY_ID=replace-with-supabase-storage-access-key-id
SUPABASE_S3_SECRET_ACCESS_KEY=replace-with-supabase-storage-secret-access-key
SUPABASE_S3_BUCKET=glowrie-media

# --- Visitor Analytics Logging (UC-006) — direct Supabase write, --------
# --- bypasses Payload entirely. NEVER prefix these NEXT_PUBLIC_ and ------
# --- never reference them from a Client Component. -----------------------
# Get these from your Supabase project: Project Settings > API.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
